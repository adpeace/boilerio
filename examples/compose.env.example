# Image reference from the GitHub release notes (pinned by digest).
BOILERIO_IMAGE=ghcr.io/adpeace/boilerio-controller@sha256:REPLACE_ME
TZ=Europe/London

# INI configuration file, readable by UID/GID 10001 (e.g. root:10001 mode 0640).
BOILERIO_CONFIG=/etc/boilerio/config.ini
# Controller cache directory, owned by 10001:10001.
BOILERIO_STATE_DIR=/var/lib/boilerio

# Stable path of the JeeLink (RF adapter): ls -l /dev/serial/by-id/
BOILER_DEVICE=/dev/serial/by-id/REPLACE_ME
# Numeric group of that device: stat -Lc %g "$BOILER_DEVICE"
SERIAL_GID=20
